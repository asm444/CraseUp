{
  "manifest_version": 3,
  "name": "CraseUp",
  "version": "0.1.0",
  "description": "Revisão de textos em português com o Gemini: sugestões mínimas, só quando necessário.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icone-16.png",
    "32": "icons/icone-32.png",
    "48": "icons/icone-48.png",
    "128": "icons/icone-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "CraseUp",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icone-16.png",
      "32": "icons/icone-32.png"
    }
  },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["src/camada.css"], "matches": ["http://*/*", "https://*/*"] }
  ]
}
